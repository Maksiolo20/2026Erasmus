#Libraries - instalation and importing
!pip install ultralytics

from ultralytics import YOLO
from google.colab import files

#Upload Video
uploaded = files.upload()
video = list(uploaded.keys())[0]

#Load Pretrained model
model = YOLO("yolov8n.pt")

#Run Object Detection
results = model(
    video,
    save=True,
    show=False
)

#Display detected objects on first frame

for box in results[0].boxes:
    label = model.names[int(box.cls[0])]
    confidence = float(box.conf[0])

    print(f"{label}: {confidence:.2f}")


#Convert to mp4 format
import os

# Define the output directory based on YOLO's output from the previous cell
output_dir = '/content/runs/detect/predict'

# The original input video filename (from previous cells) is stored in the 'video' variable
input_video_filename_original = video # 'Crossing.mp4'

# CORRECTED: The actual video file generated by YOLO is a .avi file directly in the output_dir
# (YOLO often converts .mp4 to .avi by default when saving results).
# Based on the file system, the YOLO output is named 'Crossing.avi'.
yolo_processed_video_filename = input_video_filename_original.replace('.mp4', '.avi')
output_video_path = os.path.join(output_dir, yolo_processed_video_filename)

# Define the output .mp4 filename for the re-encoded video.
# Save it to the main output_dir with a distinct name.
output_mp4_path = os.path.join(output_dir, f"reencoded_{input_video_filename_original.replace('.avi', '.mp4')}")

# Use ffmpeg to convert the video to .mp4 (or re-encode .mp4 to .mp4)
# -y flag overwrites output files without asking
!ffmpeg -i "{output_video_path}" -c:v libx264 -preset medium -crf 23 -c:a aac -b:a 128k -y "{output_mp4_path}"

print(f"Converted video saved to: {output_mp4_path}")

#Display detected Objects
for box in results[0].boxes:
    label = model.names[int(box.cls[0])]
    confidence = float(box.conf[0])

    print(f"{label}: {confidence:.2f}")

# Display the newly converted .mp4 video
  from IPython.display import Video, display

  if os.path.exists(output_mp4_path):
      print(f"Displaying converted MP4 video from: {output_mp4_path}")
      display(Video(output_mp4_path, embed=True))
  else:
      print("Error: MP4 video conversion failed or file not found.")
